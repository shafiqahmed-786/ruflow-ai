# .env.example
# RuFlow — Environment Variable Reference
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values before running:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# All secrets MUST be provided via environment — no hardcoded values in code.
# ─────────────────────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════════════════════
# LLM API KEYS (required)
# ══════════════════════════════════════════════════════════════════════════════

# Google Gemini — used for all LLM calls
GEMINI_API_KEY=your_gemini_api_key_here
# LLM MODEL CONFIGURATION (optional — defaults shown)
MODEL_STRONG=gemini-2.0-flash
MODEL_FAST=gemini-2.0-flash-lite
MODEL_GEMINI_PRO=gemini-2.0-flash
MODEL_GEMINI_LITE=gemini-2.0-flash-lite

LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3


# ══════════════════════════════════════════════════════════════════════════════
# DATABASE — MONGODB
# In docker-compose: use the service hostname (mongo)
# Local development: use localhost
# ══════════════════════════════════════════════════════════════════════════════

MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=ruflow_db
MONGODB_APPLICATIONS_COLLECTION=applications
MONGODB_SESSIONS_COLLECTION=sessions
MONGODB_POOL_SIZE=10
MONGODB_CONNECT_TIMEOUT_MS=5000


# ══════════════════════════════════════════════════════════════════════════════
# DATABASE — CHROMADB
# In docker-compose: CHROMA_HOST=chroma (internal service name)
# Local development: CHROMA_HOST=localhost, CHROMA_PORT=8001
# ══════════════════════════════════════════════════════════════════════════════

CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=/app/chroma_data
CHROMA_COLLECTION_RESUMES=resumes
CHROMA_COLLECTION_JDS=job_descriptions


# ══════════════════════════════════════════════════════════════════════════════
# EMBEDDING MODEL (Sentence Transformers — downloaded on first run)
# ══════════════════════════════════════════════════════════════════════════════

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=/app/model_cache


# ══════════════════════════════════════════════════════════════════════════════
# RETRIEVAL CONFIG
# ══════════════════════════════════════════════════════════════════════════════

RETRIEVAL_TOP_K=5
RETRIEVAL_RRF_K=60
RETRIEVAL_SEMANTIC_WEIGHT=0.7
RETRIEVAL_BM25_WEIGHT=0.3
WEB_SEARCH_ENABLED=true

# Tavily API key for optional web search (leave empty to disable)
TAVILY_API_KEY=


# ══════════════════════════════════════════════════════════════════════════════
# EVALUATION & IMPROVEMENT LOOP
# ══════════════════════════════════════════════════════════════════════════════

EVAL_SCORE_THRESHOLD=80.0
EVAL_MAX_ITERATIONS=4
EVAL_ATS_WEIGHT=0.4
EVAL_SEMANTIC_WEIGHT=0.3
EVAL_LLM_JUDGE_WEIGHT=0.3


# ══════════════════════════════════════════════════════════════════════════════
# FASTAPI APPLICATION
# ══════════════════════════════════════════════════════════════════════════════

APP_NAME=RuFlow API
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
API_PREFIX=/api/v1
WORKERS=2


# ══════════════════════════════════════════════════════════════════════════════
# NEXT.JS FRONTEND
#
# NEXT_PUBLIC_API_URL → inlined at build time; used by the browser to call
#                       the backend. Must be host-accessible (localhost).
#
# API_URL             → used server-side (SSR / Route Handlers); can use the
#                       internal Docker hostname (backend) for lower latency.
# ══════════════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_URL=http://backend:8000/api/v1
BACKEND_URL=http://backend:8000
