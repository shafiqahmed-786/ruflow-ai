# CareerOS AI — Environment Variables
# Copy this file to .env and fill in the required values.
# cp .env.example .env

# ── REQUIRED ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/careeros_db
SECRET_KEY=generate-with--python3-c--import-secrets-print-secrets.token_hex-32

# ── CORS (set to your frontend URL after deploying) ───────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── OPTIONAL — safe defaults exist ───────────────────────────────────────────
MONGODB_DB_NAME=careeros_db
CHROMA_HOST=localhost
CHROMA_PORT=8000
MODEL_STRONG=gemini-2.0-flash
MODEL_FAST=gemini-2.0-flash-lite
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
WORKERS=1
DEBUG=false
