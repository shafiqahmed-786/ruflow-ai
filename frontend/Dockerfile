# frontend/Dockerfile
# ─────────────────────────────────────────────────────────────────────────────
# RuFlow Frontend — Next.js 14 App Router (standalone output mode)
#
# Stage 1 │ deps     – install ALL node_modules (incl. devDeps for build)
# Stage 2 │ builder  – run `next build`, emit .next/standalone
# Stage 3 │ runner   – copy only runtime artefacts; no node_modules, no src
#
# Final image: node:20-alpine + standalone output + static assets only.
# Non-root user: nextjs:1001
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════════
# Stage 1 — deps
# Install all dependencies (dev + prod) needed for the build step.
# ══════════════════════════════════════════════════════════════════════════════
FROM node:20-alpine AS deps

LABEL stage="deps"

# Required for node-gyp / native modules
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copy lockfile + manifests first for maximum layer caching
COPY package.json package-lock.json* ./

# Use `npm ci` for deterministic, reproducible installs
RUN npm ci --include=dev


# ══════════════════════════════════════════════════════════════════════════════
# Stage 2 — builder
# Build the Next.js application with standalone output enabled.
# ══════════════════════════════════════════════════════════════════════════════
FROM node:20-alpine AS builder

LABEL stage="builder"

WORKDIR /app

# Bring in installed node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy source code
COPY . .

# Ensure Next.js produces a self-contained server in .next/standalone.
# next.config.js must contain: output: 'standalone'
# We set it via env here as a belt-and-suspenders fallback.
ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

# Build
RUN npm run build


# ══════════════════════════════════════════════════════════════════════════════
# Stage 3 — runner
# Minimal production image containing only runtime artefacts.
# ══════════════════════════════════════════════════════════════════════════════
FROM node:20-alpine AS runner

LABEL maintainer="ruflow-team" \
      version="0.1.0" \
      description="RuFlow Next.js frontend"

# curl required for health check
RUN apk add --no-cache curl

WORKDIR /app

# ── Non-root user ─────────────────────────────────────────────────────────────
RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 --ingroup nodejs nextjs

# ── Copy standalone server bundle ─────────────────────────────────────────────
# .next/standalone contains server.js + all required node_modules (no devDeps)
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./

# ── Copy static assets ────────────────────────────────────────────────────────
# Static files must be placed at ./public/  and ./.next/static/ relative to
# the standalone output so Next.js serves them correctly.
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public       ./public

# ── Switch to non-root ────────────────────────────────────────────────────────
USER nextjs

# ── Port ──────────────────────────────────────────────────────────────────────
EXPOSE 3000

# ── Health check ──────────────────────────────────────────────────────────────
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000 || exit 1

# ── Environment defaults ──────────────────────────────────────────────────────
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# ── Entrypoint ────────────────────────────────────────────────────────────────
# server.js is the self-contained Next.js server generated by standalone mode.
CMD ["node", "server.js"]
